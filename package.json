{
  "name": "playground-mineflayer",
  "version": "1.0.0",
  "scripts": {
    "start": "pnpm run bot:npc",
    "bot:companion": "pnpm run bot:npc",
    "bot:smart": "node base_bot_smart.js",
    "bot:base": "node base_bot.js",
    "test": "pnpm run build && \"$npm_node_execpath\" --test dist/test/unit/*.test.js",
    "build": "\"$npm_node_execpath\" node_modules/typescript/bin/tsc",
    "typecheck": "\"$npm_node_execpath\" node_modules/typescript/bin/tsc --noEmit",
    "bot:npc": "pnpm run build && \"$npm_node_execpath\" dist/src/bot.js",
    "test:paper": "pnpm run build && \"$npm_node_execpath\" --test dist/test/integration/stage-two-paper.test.js"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-statemachine": "^1.7.0",
    "mineflayer-tool": "^1.2.0",
    "prismarine-viewer": "^1.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
